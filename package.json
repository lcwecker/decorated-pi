{
    "name": "decorated-pi",
    "version": "0.9.4",
    "description": "decorated-pi is a practical enhancement pack for pi coding agent — token-efficient workflow, cache-friendly design, and smarter tools.",
    "keywords": [
        "pi",
        "pi-package",
        "pi-extension",
        "mcp",
        "security",
        "lsp",
        "lsp-client",
        "secret-redaction",
        "codegraph"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lcwecker/decorated-pi.git"
    },
    "homepage": "https://github.com/lcwecker/decorated-pi#readme",
    "bugs": "https://github.com/lcwecker/decorated-pi/issues",
    "engines": {
        "node": ">=22.19.0"
    },
    "dependencies": {
        "@biomejs/biome": "^2.5.5",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "chardet": "^2.2.0",
        "iconv-lite": "^0.7.2",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": ">=0.84.4",
        "@earendil-works/pi-ai": ">=0.84.4",
        "@earendil-works/pi-coding-agent": ">=0.84.4",
        "@earendil-works/pi-tui": ">=0.84.4",
        "typebox": "*"
    },
    "pi": {
        "extensions": [
            "./index.ts"
        ]
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "^0.84.4",
        "@earendil-works/pi-ai": "^0.84.4",
        "@earendil-works/pi-coding-agent": "^0.84.4",
        "@earendil-works/pi-tui": "^0.84.4",
        "@types/node": "^22.15.3",
        "@vitest/coverage-v8": "4.1.8",
        "depcheck": "^1.4.7",
        "publint": "^0.3.21",
        "vitest": "4.1.8"
    },
    "scripts": {
        "prepack": "depcheck --fail-on-missing",
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm install --no-audit --no-fund && npm test && npm run typecheck && depcheck --fail-on-missing && publint"
    }
}
